# --- app/ (Expo/React Native) ---
app/node_modules/
app/.expo/
app/dist/
app/web-build/
app/*.jks
app/*.p8
app/*.p12
app/*.key
app/*.mobileprovision
app/.env
app/.env.local
# ad-hoc debug screenshots / uiautomator dumps left at the app root during emulator testing
app/*.png
app/*.xml

# --- backend/ (Python/FastAPI) ---
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.env
backend/.pytest_cache/
# ad-hoc debug screenshots / uiautomator dumps left at the backend root during testing
backend/*.png
backend/*.xml

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp
.claude/settings.local.json
