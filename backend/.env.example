# Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co

# Supabase project settings > Database > Connection string
# Pooled (pgbouncer, port 6543) — used by the running app for short-lived queries
DATABASE_URL=postgresql+asyncpg://postgres:password@aws-0-your-region.pooler.supabase.com:6543/postgres
# Session pooler (port 5432) — used only by Alembic for migrations.
# Note: the raw direct-connection host (db.<ref>.supabase.co) is IPv6-only unless
# you pay for Supabase's IPv4 add-on, so use the session pooler instead — same
# host as the transaction pooler above, just port 5432 for full session semantics.
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres
